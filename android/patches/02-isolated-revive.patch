+	if (state.slot !== getTaskIsolationSlot(state.repoRoot, state.id)) {
+		return {
+			refusal: `isolation slot "${state.slot}" does not belong to repo ${state.repoRoot} and "${state.id}"`,
+		};
+	}
+	if (!state.sessionFile) return { refusal: "isolation state is not bound to a transcript" };
+	// `expectedSessionFile` is passed by the lifecycle caller independently of the
+	// descriptor: both sides must resolve to the SAME regular file, so a forged
+	// descriptor cannot self-verify by naming its own transcript.
+	const [bound, transcript] = await Promise.all([realFile(state.sessionFile), realFile(sessionFile)]);
+	if (!bound || !transcript || bound !== transcript) {
+		return {
+			refusal: `isolation state belongs to transcript ${state.sessionFile}, not ${sessionFile}`,
+		};
+	}
+	// Paths are reused when an agent id is reused; the session-header id is the
+	// generation token. Descriptors written before it are fail-safe, not trusted.
+	if (!state.childSessionId) {
+		if (!options?.allowLegacyGeneration) {
+			return {
+				refusal:
+					"isolation state has no child session generation; automatic revive/release is refused. Use explicit `omp worktree release <sandbox>` (it re-verifies transcript cwd and the retention pointer) or copy the data out manually; do not delete the workspace",
+			};
+		}
+	} else {
+		const headerId = await readSessionHeaderId(sessionFile);
+		if (headerId !== state.childSessionId) {
+			return {
+				refusal: `isolation state belongs to session ${state.childSessionId}, not ${headerId ?? "unknown"}`,
+			};
+		}
+	}
+	const [source, baselineRoot] = await Promise.all([
+		realDirectory(state.repoRoot),
+		realDirectory(state.baseline.root.repoRoot),
+	]);
+	if (!source || !baselineRoot || source !== baselineRoot) {
+		return {
+			refusal: `isolation baseline root ${state.baseline.root.repoRoot} does not match ${state.repoRoot}`,
+		};
+	}
+	const workspace = path.join(dir, state.mergedDir);
+	const workspaceReal = await realDirectory(workspace);
+	if (!workspaceReal || !workspaceReal.startsWith(`${dir}${path.sep}`)) {
+		return { refusal: `isolation workspace ${workspace} is gone or escapes its sandbox` };
+	}
+	return { workspaceDir: workspace };
+}
+
+/** Outcome of proving a workspace's transcript is genuinely its own. */
+export type PersistedReleaseIdentity = { transcriptFile: string; artifactsDir: string } | { refusal: string };
+
+/** First record of a transcript, read in a bounded prefix instead of the whole file. */
+async function readSessionHeader(file: string): Promise<Record<string, unknown> | undefined> {
+	let handle: FileHandle | undefined;
+	try {
+		handle = await fs.open(file, "r");
+		const buffer = Buffer.alloc(64 * 1024);
+		const { bytesRead } = await handle.read(buffer, 0, buffer.length, 0);
+		const line = buffer.subarray(0, bytesRead).toString("utf8").split("\n", 1)[0];
+		const parsed: unknown = JSON.parse(line);
+		return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+			? (parsed as Record<string, unknown>)
+			: undefined;
+	} catch {
+		return undefined;
+	} finally {
+		await handle?.close();
+	}
+}
+
+/**
+ * Session-header id of a transcript: the durable generation token. Unlike the
+ * file path (reused when an agent id is reused) it changes for a new session.
+ */
+export async function readSessionHeaderId(file: string): Promise<string | undefined> {
+	const header = await readSessionHeader(file);
+	return header?.type === "session" && typeof header.id === "string" && header.id.length > 0 ? header.id : undefined;
+}
+
+/**
+ * Independent transcript identity for an explicit release: the descriptor alone
+ * cannot authorize capture because a copied descriptor can point its own
+ * `sessionFile` at another session. The selected workspace is authorized by
+ * the directory the user named, and the transcript must independently prove it
+ * was created in that workspace (session header cwd) — plus, when the retention
+ * pointer exists beside it, that it names the same workspace. This also fixes
+ * the artifact directory to the verified transcript's directory, so release
+ * cannot overwrite another agent's `<id>.patch`.
+ */
+export async function bindPersistedReleaseWorkspace(
+	state: LoadedIsolationState,
+	options?: { requirePointer?: boolean },
+): Promise<PersistedReleaseIdentity> {
+	const named = state.sessionFile;
+	if (!named) return { refusal: "its descriptor does not name a transcript" };
+	const transcript = await realFile(named);
+	if (!transcript) return { refusal: `its transcript ${named} is not a readable file` };
+	if (path.basename(transcript) !== `${state.id}.jsonl`) {
+		return { refusal: `transcript ${transcript} is not "${state.id}.jsonl"` };
+	}
+	const header = await readSessionHeader(transcript);
+	if (header?.type !== "session" || typeof header.cwd !== "string" || !path.isAbsolute(header.cwd)) {
+		return { refusal: `transcript ${transcript} has no usable session header` };
+	}
+	const headerCwd = path.resolve(header.cwd);
+	const slotCwd = path.resolve(getWorktreesDir(), state.slot, state.mergedDir);
+	const retainedCwd = path.resolve(state.dir, state.mergedDir);
+	if (headerCwd !== slotCwd && headerCwd !== retainedCwd) {
+		return { refusal: `transcript ${transcript} was not created in ${state.dir}` };
+	}
+	const pointerFile = path.join(path.dirname(transcript), `${state.id}.isolation.json`);
+	try {
+		const pointer: unknown = await Bun.file(pointerFile).json();
+		if (pointer === null || typeof pointer !== "object" || Array.isArray(pointer)) {
+			return { refusal: `its isolation pointer ${pointerFile} is malformed (expected an object)` };
+		}
+		const record = pointer as { dir?: unknown; workspace?: unknown };
+		if (typeof record.workspace !== "string" || record.workspace.length === 0) {
+			return { refusal: `its isolation pointer ${pointerFile} has no workspace string` };
+		}
+		if (record.dir !== undefined && typeof record.dir !== "string") {
+			return { refusal: `its isolation pointer ${pointerFile} has a malformed dir` };
+		}
+		const workspace = record.workspace;
+		// Every writer stores the MOUNT: spawn writes `<base>/m`, retention
+		// writes `<base>.retained-*/m`. Compare canonically against that mount.
+		const [pointerWorkspace, mount] = await Promise.all([
+			realDirectory(workspace),
+			realDirectory(path.join(state.dir, state.mergedDir)),
+		]);
+		if (!pointerWorkspace || !mount || pointerWorkspace !== mount) {
+			return { refusal: `transcript ${transcript} points at ${workspace}, not ${state.dir}` };
+		}
+		// `dir` is the sandbox base that contains the mount, for both original
+		// and retained workspaces.
+		if (typeof record.dir === "string") {
+			const pointerDir = await realDirectory(record.dir);
+			if (!pointerDir || pointerDir !== path.dirname(pointerWorkspace)) {
+				return { refusal: `its isolation pointer ${pointerFile} has an inconsistent dir` };
+			}
+		}
+	} catch (error) {
+		if (!isEnoent(error)) return { refusal: `its isolation pointer ${pointerFile} is unreadable` };
+		if (options?.requirePointer) {
+			return {
+				refusal: `its isolation pointer ${pointerFile} is missing; legacy recovery requires the pointer as independent workspace evidence`,
+			};
+		}
+	}
+	return { transcriptFile: transcript, artifactsDir: path.dirname(transcript) };
+}
+
+/**
+ * Resolve the persisted isolation descriptor for a transcript, following the
+ * retention rename, and prove it is bound to this transcript.
+ *
+ * The header cwd is the deterministic sandbox mount; retention renames the
+ * whole sandbox, so the pointer beside the transcript is the second candidate.
+ * A descriptor is REQUIRED: a bare workspace directory cannot be revived,
+ * because without the persisted baseline the run could neither capture its
+ * delta nor stop the recorded backend, and reviving in the parent cwd would
+ * contradict the isolation contract.
+ */
+/**
+ * Find slot-named ancestor/retained leftovers whose descriptor is bound to this transcript.
+ *
+ * The pointer is written after the rename, so a failed write (disk full) or a
+ * crash in between leaves the renamed workspace undiscoverable from the header
+ * cwd. The deterministic slot prefix makes it recoverable by scan; a workspace
+ * only counts when its descriptor binds to this transcript, and more than one
+ * match is ambiguous — reviving into a guess could capture the wrong copy.
+ */
+async function findBoundRetainedSiblings(
+	sessionFile: string,
+	id: string,
+): Promise<{ state: LoadedIsolationState; workspaceDir: string }[]> {
+	const root = await realDirectory(getWorktreesDir());
+	if (!root) return [];
+	let names: string[];
+	try {
+		names = await fs.readdir(root);
+	} catch {
+		return [];
+	}
+	const matches: { state: LoadedIsolationState; workspaceDir: string }[] = [];
+	for (const name of names.sort()) {
+		// One parser defines the shape: a plain slot or its `.retained-*` sibling.
+		// Concatenating anchored sources would yield `^…$^…$`, which matches
+		// nothing, so the scan reuses the parser instead of a second regex.
+		if (isolationSlotFromDirName(name) === undefined) continue;
+		const read = await readIsolationState(path.join(root, name), id);
+		if ("error" in read) continue;
+		const bound = await bindIsolationState(read.state, sessionFile);
+		if ("refusal" in bound) continue;
+		matches.push({ state: read.state, workspaceDir: bound.workspaceDir });
+	}
+	return matches;
+}
+
+export async function resolveIsolationWorkspace(
+	sessionFile: string,
+	id: string,
+	headerCwd: string,
+): Promise<IsolationWorkspaceResolution> {
+	const candidates: string[] = [];
+	if (isNormalizedAbsolutePath(headerCwd)) candidates.push(path.dirname(headerCwd));
+	try {
+		const pointer: unknown = await Bun.file(path.join(path.dirname(sessionFile), `${id}.isolation.json`)).json();
+		if (pointer !== null && typeof pointer === "object" && "dir" in pointer && typeof pointer.dir === "string") {
+			// The pointer comes from a file next to the transcript, not from this
+			// process: only an absolute, normalized dir may become a candidate, and
+			// the descriptor binding below still has to prove ownership.
+			if (isNormalizedAbsolutePath(pointer.dir)) candidates.push(pointer.dir);
+		}
+	} catch {
+		// No pointer: an unrenamed workspace still resolves through the header cwd.
+	}
+	let refusal: string | undefined;
+	for (const dir of candidates) {
+		const read = await readIsolationState(dir, id);
+		if ("error" in read) {
+			if (read.error !== "missing" && refusal === undefined) refusal = read.detail;
+			continue;
+		}
+		const bound = await bindIsolationState(read.state, sessionFile);
+		if ("refusal" in bound) {
+			refusal = bound.refusal;
+			continue;
+		}
+		return { state: read.state, workspaceDir: bound.workspaceDir };
+	}
+	const recovered = await findBoundRetainedSiblings(sessionFile, id);
+	if (recovered.length === 1) return recovered[0];
+	if (recovered.length > 1) {
+		return {
+			refusal: `${recovered.length} retained workspaces are bound to this transcript (${recovered
+				.map(match => match.state.dir)
+				.join(", ")}); refusing to guess which one to revive`,
+		};
+	}
+	return {
+		refusal: refusal ?? "isolation state missing (its workspace was never retained or was already released)",
+	};
+}
+
+/** Atomically replace the descriptor: a crash leaves either the old file or the new one, never a torn one. */
+export async function writeIsolationState(baseDir: string, state: IsolationState): Promise<void> {
+	const file = path.join(baseDir, ISOLATION_STATE_FILE);
+	const temp = `${file}.${process.pid}-${Math.random().toString(16).slice(2)}.tmp`;
+	await Bun.write(temp, JSON.stringify(state));
+	try {
+		await fs.rename(temp, file);
+	} catch (error) {
+		await fs.rm(temp, { force: true }).catch(() => undefined);
+		throw error;
+	}
+}
+
+/**
+ * Merge run-end facts into an existing descriptor. Best-effort by design: a
+ * missing or unreadable descriptor only degrades a later release to an
+ * unconditional re-capture, which is why the caller logs instead of failing the
+ * run that already produced its result.
+ *
+ * Each write is an atomic replace that preserves the fields this call does not
+ * touch, but the read/merge/write is not a cross-process transaction: run-end
+ * facts have a single writer per run, and a racing writer can only replace the
+ * whole file (last write wins), never tear it into an invalid descriptor.
+ */
+export async function patchIsolationState(
+	baseDir: string,
+	patch: {
+		sessionFile?: string;
+		handedOff?: string;
+		childSessionId?: string;
+		deferredReady?: boolean;
+		parentSessionFile?: string;
+		parentSessionId?: string;
+	},
+): Promise<boolean> {
+	const read = await readIsolationState(baseDir);
+	if (!("state" in read)) return false;
+	const sessionFile = patch.sessionFile ?? read.state.sessionFile;
+	const handedOff = patch.handedOff ?? read.state.handedOff;
+	const childSessionId = patch.childSessionId ?? read.state.childSessionId;
+	const deferredReady = patch.deferredReady ?? read.state.deferredReady;
+	const parentSessionFile = patch.parentSessionFile ?? read.state.parentSessionFile;
+	const parentSessionId = patch.parentSessionId ?? read.state.parentSessionId;
+	await writeIsolationState(baseDir, {
+		version: read.state.version,
+		id: read.state.id,
+		repoRoot: read.state.repoRoot,
+		backend: read.state.backend,
+		slot: read.state.slot,
+		mergedDir: read.state.mergedDir,
+		baseline: read.state.baseline,
+		...(sessionFile === undefined ? {} : { sessionFile }),
+		...(read.state.deferred === undefined ? {} : { deferred: read.state.deferred }),
+		...(deferredReady === undefined ? {} : { deferredReady }),
+		...(read.state.mergeMode === undefined ? {} : { mergeMode: read.state.mergeMode }),
+		...(childSessionId === undefined ? {} : { childSessionId }),
+		...(parentSessionFile === undefined ? {} : { parentSessionFile }),
+		...(parentSessionId === undefined ? {} : { parentSessionId }),
+		...(handedOff === undefined ? {} : { handedOff }),
+	});
+	return true;
+}
+
+/** Handle for tearing down a workspace described by a loaded descriptor. */
+export function isolationHandle(state: LoadedIsolationState): IsolationHandle {
+	return {
+		mergedDir: path.join(state.dir, state.mergedDir),
+		backend: state.backend,
+		fellBack: false,
+		fallbackReason: null,
+	};
+}
+
