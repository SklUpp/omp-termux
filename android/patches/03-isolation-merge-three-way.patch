diff --git a/packages/coding-agent/test/isolation-merge-three-way.test.ts b/packages/coding-agent/test/isolation-merge-three-way.test.ts
new file mode 100644
index 0000000..741ba65
--- /dev/null
+++ b/packages/coding-agent/test/isolation-merge-three-way.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, it } from "bun:test";
+import { execFileSync } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { mergeIsolatedChanges } from "../src/task/isolation-runner";
+import type { SingleResult } from "../src/task/types";
+
+// Regression coverage for concurrent isolated runs: every worker's delta patch
+// is authored against the spawn-time baseline, so an earlier merge shifts the
+// hunk line positions of a later patch. Patch-mode merge must compose disjoint
+// drifted deltas through the three-way path and refuse genuine conflicts
+// fail-clean (parent state untouched, patch artifact named).
+describe("isolation patch-mode merge of concurrent deltas", () => {
+	function git(dir: string, ...args: string[]): string {
+		return execFileSync("git", args, { cwd: dir, encoding: "utf8" });
+	}
+
+	const SEED = "header\nline-1\nline-2\nline-3\nline-4\nline-5\nline-6\nline-7\nline-8\nline-9\nline-10\nline-11\nline-12\nline-13\nline-14\nline-15\nline-16\nline-17\nline-18\nline-19\nline-20\nfooter\n";
+
+	function makeRepo(): string {
+		const dir = fs.mkdtempSync(path.join(os.tmpdir(), "iso-merge-"));
+		git(dir, "init", "-q");
+		git(dir, "config", "user.name", "iso-merge-test");
+		git(dir, "config", "user.email", "iso-merge@example.invalid");
+		fs.writeFileSync(path.join(dir, "work.txt"), SEED);
+		git(dir, "add", "work.txt");
+		git(dir, "commit", "-qm", "seed");
+		return dir;
+	}
+
+	/** Capture a delta patch exactly like isolation does: `git diff` of the edit, then restore. */
+	function captureDelta(dir: string, mutate: (text: string) => string, name: string): string {
+		const file = path.join(dir, "work.txt");
+		const before = fs.readFileSync(file, "utf8");
+		fs.writeFileSync(file, mutate(before));
+		const patch = git(dir, "diff", "--no-ext-diff");
+		expect(patch).toContain("index ");
+		const patchPath = path.join(dir, `${name}.patch`);
+		fs.writeFileSync(patchPath, patch);
+		fs.writeFileSync(file, before);
+		return patchPath;
+	}
+
+	function mergeResult(patchPath: string): SingleResult {
+		return {
+			index: 0,
+			id: "iso-merge-test",
+			agent: "sonic",
+			task: "test",
+			exitCode: 0,
+			output: "",
+			stderr: "",
+			truncated: false,
+			durationMs: 0,
+			tokens: 0,
+			requests: 0,
+			patchPath,
+		} as unknown as SingleResult;
+	}
+
+	it("composes a later worker's drifted delta after an earlier merge shifted its lines", async () => {
+		const dir = makeRepo();
+		try {
+			const patchA = captureDelta(dir, (t) => t.replace("header\n", "header\nworker-a: alpha\n"), "worker-a");
+			const patchB = captureDelta(dir, (t) => t.replace("footer\n", "worker-b: beta\nfooter\n"), "worker-b");
+
+			const first = await mergeIsolatedChanges({ result: mergeResult(patchA), repoRoot: dir, mergeMode: "patch" });
+			expect(first.changesApplied).toBe(true);
+			expect(first.hadAnyChanges).toBe(true);
+			expect(first.summary).toContain("Applied patches: yes");
+
+			// Worker B's patch was captured against the pre-A baseline: its hunk
+			// header says line 20 while the match now sits at line 21. Refusing
+			// it loses B's work; the merge must compose it.
+			const second = await mergeIsolatedChanges({ result: mergeResult(patchB), repoRoot: dir, mergeMode: "patch" });
+			expect(second.changesApplied).toBe(true);
+			expect(second.hadAnyChanges).toBe(true);
+
+			expect(fs.readFileSync(path.join(dir, "work.txt"), "utf8")).toBe(
+				"header\nworker-a: alpha\nline-1\nline-2\nline-3\nline-4\nline-5\nline-6\nline-7\nline-8\nline-9\nline-10\nline-11\nline-12\nline-13\nline-14\nline-15\nline-16\nline-17\nline-18\nline-19\nline-20\nworker-b: beta\nfooter\n",
+			);
+		} finally {
+			fs.rmSync(dir, { recursive: true, force: true });
+		}
+	});
+
+	it("refuses a genuinely conflicting delta fail-clean and preserves the parent state", async () => {
+		const dir = makeRepo();
+		try {
+			const conflicting = captureDelta(dir, (t) => t.replace("line-5\n", "theirs-edit\n"), "conflict");
+			const ours = SEED.replace("line-5\n", "ours-edit\n");
+			fs.writeFileSync(path.join(dir, "work.txt"), ours);
+
+			const out = await mergeIsolatedChanges({ result: mergeResult(conflicting), repoRoot: dir, mergeMode: "patch" });
+			expect(out.changesApplied).toBe(false);
+			expect(out.summary).toContain("were not applied");
+			expect(out.summary).toContain(path.basename(conflicting));
+			// Fail-clean: the parent keeps its own version, no conflict markers.
+			expect(fs.readFileSync(path.join(dir, "work.txt"), "utf8")).toBe(ours);
+		} finally {
+			fs.rmSync(dir, { recursive: true, force: true });
+		}
+	});
+});
