+				} else if (await repo.canApplyPatch(normalized, { threeWay: true }).catch(() => false)) {
+					// Context drift: earlier merges or a dirty baseline shifted the
+					// hunk lines (concurrent isolated deltas are all captured against
+					// the spawn-time baseline). The three-way merge composes drifted
+					// and overlapping deltas and fails clean on genuine conflicts —
