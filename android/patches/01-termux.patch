+		"Reinstall the release profile you use:",
+		`  standard: curl -fsSL ${ANDROID_INSTALLER_URL} | sh`,
+		`  extended: curl -fsSL ${ANDROID_INSTALLER_URL} | sh -s -- -ex`,
+		`Releases: https://github.com/${ANDROID_REPO}/releases`,
