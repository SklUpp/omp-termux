+
+		const outcome = await sendAndroidNotification("omp", "Complete");
+
+		expect(outcome.ok).toBe(false);
+		expect(outcome.error?.length).toBeLessThanOrEqual(512);
+		expect(outcome.error).not.toContain("--id");
