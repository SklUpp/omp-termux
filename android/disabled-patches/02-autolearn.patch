+		if (candidate.projectIdentity !== projectIdentity && candidate.scope !== "global") {
+			return { success: false, error: "Unauthorized project scope" };
+		}
+		if (
+			candidate.status !== "needs_review" &&
+			candidate.status !== "approved" &&
